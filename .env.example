# Copie este archivo como .env y complete los valores (no suba .env al repositorio)
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
# MySQL 8.0 (producción / pruebas con la base real)
DATABASE_URL=mysql+pymysql://asistencia:CLAVE@localhost:3306/bd_asistencia?charset=utf8mb4
# Sincronización automática con el reloj ZKTeco
SCHEDULER_ENABLED=false
SYNC_MINUTES=30
ZK_TIMEOUT=5
MAX_INTENTOS_LOGIN=5
